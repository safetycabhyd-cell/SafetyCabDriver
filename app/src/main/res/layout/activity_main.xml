<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================================================= -->
        <!-- SAFETY CAB COMPLETE LOGO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgSafetyCabLogo"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:src="@drawable/file_000000005080820eb97aa57d3fa76943"
                android:scaleType="fitCenter"
                android:contentDescription="Safety Cab Logo" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DUTY STATUS - TOP -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚕  DUTY"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#12345B" />

            <Button
                android:id="@+id/btnDuty"
                android:layout_width="150dp"
                android:layout_height="52dp"
                android:text="START DUTY"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0757A6"
                android:gravity="center" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvDutyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OFF DUTY"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0757A6"
            android:gravity="center"
            android:padding="4dp" />


        <!-- ================================================= -->
        <!-- DRIVER PROFILE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgDriverPhoto"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:scaleType="centerInside"
                android:contentDescription="Driver Photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DRIVER"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0757A6" />

                <TextView
                    android:id="@+id/tvDriverId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not Registered"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="#12345B"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Driver photo"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:paddingTop="2dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- HELP & SUPPORT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Help and Support"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#12345B" />

                <TextView
                    android:id="@+id/tvCompanyPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="08062180745"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0757A6"
                    android:paddingTop="3dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnCompanyCall"
                android:layout_width="105dp"
                android:layout_height="50dp"
                android:text="📞 CALL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0757A6" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CAR INFORMATION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgCarPhoto"
                android:layout_width="145dp"
                android:layout_height="95dp"
                android:src="@android:drawable/ic_menu_directions"
                android:scaleType="centerInside"
                android:contentDescription="Car Photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CAR NUMBER"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0757A6" />

                <TextView
                    android:id="@+id/tvCarNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not Registered"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#12345B"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Car photo"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:paddingTop="2dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SETTINGS -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="⚙  SETTINGS"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0757A6" />


        <!-- ================================================= -->
        <!-- HIDDEN SYSTEM FIELDS -->
        <!-- MainActivity.kt IDs preserved -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="GPS: Not Started" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="Firebase: Not Connected" />

        <TextView
            android:id="@+id/tvLastLocation"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="Latitude: --&#10;Longitude: --&#10;Last Update: --" />

        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:text="Tracking: Stopped" />


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Safety Cab Driver App"
            android:textSize="12sp"
            android:textColor="#6B7C93"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="15dp" />

    </LinearLayout>

</ScrollView>
